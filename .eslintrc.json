{
  "extends": ["next/core-web-vitals", "google"],
  "rules": {
    "max-len": ["error", {"code": 100, "ignoreUrls": true, "ignoreStrings": true}],
    "object-curly-spacing": ["error", "always"],
    "indent": ["error", 2, {"SwitchCase": 1}],
    "quote-props": "off",
    "operator-linebreak": "off",
    "require-jsdoc": "off",
    "valid-jsdoc": "off"
  }
}
